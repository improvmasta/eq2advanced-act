<Project Sdk="Microsoft.NET.Sdk">

  <!--
    eq2advanced uploader - MULTI-LOG TEST TRACK.

    The same source as EQ2Advanced, compiled a second time with MULTILOG
    defined. There is no second copy of anything: the Compile glob below points
    at the stable project's files, and the only thing that differs is a handful
    of constants in Core/Channel.cs.

    Why a separate ASSEMBLY rather than one DLL with a setting: ACT loads every
    plugin into one AppDomain and lists them by assembly, so two files claiming
    the identity `EQ2Advanced` cannot both be added. A test track that replaced
    the working uploader on disk would not be a test track - the whole promise
    is that the stable one is still sitting there, one checkbox away, when a
    raid starts in ten minutes.

    Its version moves independently (Core/Channel.cs), and it reports a
    different User-Agent product token, so a test build can never put an update
    pill in front of somebody running the stable DLL.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>EQ2AdvancedMulti</AssemblyName>
    <RootNamespace>EQ2Advanced</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);MULTILOG</DefineConstants>

    <AssemblyTitle>eq2advanced uploader (multi-log test build)</AssemblyTitle>
    <Product>eq2advanced</Product>
    <Description>Test build: follows every EverQuest II log on this PC, not just the one ACT is reading.</Description>
    <Authors>EQ2Advanced</Authors>
    <!-- Keep in step with Channel.Version. -->
    <Version>0.3.0</Version>

    <ACTPath Condition="'$(ACTPath)' == ''">$(MSBuildThisFileDirectory)..\Thirdparty\ACT</ACTPath>

    <!-- The sources live in the sibling project, so the SDK's own globs (which
         would find nothing here) are turned off and replaced below. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\EQ2Advanced\**\*.cs"
             Exclude="..\EQ2Advanced\bin\**\*.cs;..\EQ2Advanced\obj\**\*.cs">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Advanced Combat Tracker">
      <HintPath>$(ACTPath)\Advanced Combat Tracker.exe</HintPath>
      <SpecificVersion>false</SpecificVersion>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckACT" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(ACTPath)\Advanced Combat Tracker.exe')"
           Text="No ACT at '$(ACTPath)'. Run tools/fetch-act.sh (or build.ps1 on Windows), or pass -p:ACTPath=&lt;your ACT folder&gt;." />
  </Target>

</Project>
