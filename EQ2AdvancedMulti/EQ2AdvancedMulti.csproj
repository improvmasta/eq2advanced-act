<Project Sdk="Microsoft.NET.Sdk">

  <!--
    eq2advanced uploader - MULTI-LOG TEST TRACK.

    The same source as EQ2Advanced, compiled a second time with MULTILOG
    defined. There is no second copy of anything: the Compile glob below points
    at the stable project's files, and the only thing that differs is a handful
    of constants in Core/Channel.cs.

    It produces EQ2Advanced.dll, the same assembly name as the stable build, in
    its own output folder. That is deliberate: the test build REPLACES the
    plugin rather than installing beside it, so a raider drops this DLL over
    the old one and keeps their tab, their pairing and their cursors. Two
    projects exist only so both builds can be produced and served from one
    push - never so both can be loaded at once.

    Its version moves independently (Core/Channel.cs), and it reports a
    different User-Agent product token, so the site can tell which build
    somebody is on without ever offering them the other as an "update".
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <!-- The same name as the stable build: this is a replacement DLL, and the
         output folder is what keeps the two builds apart on disk. -->
    <AssemblyName>EQ2Advanced</AssemblyName>
    <RootNamespace>EQ2Advanced</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);MULTILOG</DefineConstants>

    <AssemblyTitle>eq2advanced uploader (multi-log test build)</AssemblyTitle>
    <Product>eq2advanced</Product>
    <Description>Test build: follows every EverQuest II log on this PC, not just the one ACT is reading.</Description>
    <Authors>EQ2Advanced</Authors>
    <!-- Keep in step with Channel.Version. -->
    <Version>0.3.2</Version>

    <ACTPath Condition="'$(ACTPath)' == ''">$(MSBuildThisFileDirectory)..\Thirdparty\ACT</ACTPath>

    <!-- The sources live in the sibling project, so the SDK's own globs (which
         would find nothing here) are turned off and replaced below. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\EQ2Advanced\**\*.cs"
             Exclude="..\EQ2Advanced\bin\**\*.cs;..\EQ2Advanced\obj\**\*.cs">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Advanced Combat Tracker">
      <HintPath>$(ACTPath)\Advanced Combat Tracker.exe</HintPath>
      <SpecificVersion>false</SpecificVersion>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckACT" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(ACTPath)\Advanced Combat Tracker.exe')"
           Text="No ACT at '$(ACTPath)'. Run tools/fetch-act.sh (or build.ps1 on Windows), or pass -p:ACTPath=&lt;your ACT folder&gt;." />
  </Target>

</Project>
